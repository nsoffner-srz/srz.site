---
// Layout base de todas as páginas: SEO, dados estruturados, cabeçalho e rodapé.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  titulo: string; // título da página, sem o nome da empresa
  descricao?: string;
  tipoOg?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  semIndice?: boolean;
}

const { titulo, descricao = SITE.descricao, tipoOg = 'website', jsonLd = [], semIndice = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE.url).href;
const tituloCompleto = Astro.url.pathname === '/' ? `${SITE.nome} | ${titulo}` : `${titulo} | ${SITE.nome}`;

const organizacao = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organizacao`,
  name: 'Sensoriz',
  url: SITE.url,
  logo: `${SITE.url}/icon-512.png`,
  description: SITE.descricao,
  sameAs: Object.values(SITE.redes),
};
const dados = [organizacao, ...jsonLd];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    {semIndice && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F4F8FC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#060B14" media="(prefers-color-scheme: dark)" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Conteúdo Sensoriz" href="/conteudo/rss.xml" />

    <meta property="og:site_name" content="Sensoriz" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={tipoOg} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/icon-512.png`} />
    <meta name="twitter:card" content="summary" />

    {dados.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
