---
// Cabeçalho: logo, menu, login da CORE e o CTA de diagnóstico.
// Menus abrem por toque ou clique (<details>), nada depende de passar o mouse.
import Logo from './Logo.astro';
import { NAV, SITE } from '../data/site';
const atual = Astro.url.pathname;
const ativo = (href: string) => atual === href || atual.startsWith(href + '/');
---
<header class="topo">
  <div class="container topo__barra">
    <a href="/" class="topo__logo" aria-label="Sensoriz, página inicial"><Logo largura={148} /></a>

    <nav class="topo__nav" aria-label="Principal">
      <ul>
        {NAV.map((item) => (
          <li>
            {item.filhos ? (
              <details class="menu">
                <summary class:list={['topo__link', { 'is-ativo': ativo(item.href) }]}>{item.rotulo}</summary>
                <ul class="menu__lista">
                  <li><a href={item.href}>Ver todos</a></li>
                  {item.filhos.map((f) => <li><a href={f.href} aria-current={atual === f.href ? 'page' : undefined}>{f.rotulo}</a></li>)}
                </ul>
              </details>
            ) : (
              <a class:list={['topo__link', { 'is-ativo': ativo(item.href) }]} href={item.href} aria-current={ativo(item.href) ? 'page' : undefined}>{item.rotulo}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="topo__acoes">
      <a class="topo__login" href={SITE.loginCore}>Entrar na CORE</a>
      <a class="botao botao--primario" href="/diagnostico">Solicitar diagnóstico</a>
    </div>

    <details class="movel">
      <summary class="movel__botao" aria-label="Abrir menu">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span>Menu</span>
      </summary>
      <div class="movel__painel">
        <nav aria-label="Principal no celular">
          {NAV.map((item) => (
            <div class="movel__grupo">
              <a class="movel__titulo" href={item.href}>{item.rotulo}</a>
              {item.filhos && (
                <ul>{item.filhos.map((f) => <li><a href={f.href}>{f.rotulo}</a></li>)}</ul>
              )}
            </div>
          ))}
        </nav>
        <a class="botao botao--primario" href="/diagnostico">Solicitar diagnóstico</a>
        <a class="botao botao--secundario" href={SITE.loginCore}>Entrar na Sensoriz CORE</a>
      </div>
    </details>
  </div>
</header>

<script>
  // Fecha um menu quando outro abre ou quando a pessoa toca fora dele.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('.topo details'));
  menus.forEach((m) => m.addEventListener('toggle', () => {
    if (m.open) menus.forEach((o) => { if (o !== m) o.open = false; });
  }));
  document.addEventListener('click', (e) => {
    menus.forEach((m) => { if (m.open && !m.contains(e.target as Node)) m.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menus.forEach((m) => (m.open = false));
  });
</script>

<style>
  .topo { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--superficie) 92%, transparent); backdrop-filter: saturate(1.4) blur(8px); border-bottom: 1px solid var(--borda-sutil); }
  .topo__barra { display: flex; align-items: center; gap: var(--space-5); min-height: 72px; }
  .topo__logo { display: inline-flex; padding-block: 12px; }
  .topo__nav { display: none; flex: 1; }
  .topo__nav > ul { display: flex; gap: var(--space-1); list-style: none; margin: 0; padding: 0; }
  .topo__link { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px; border-radius: var(--radius-md); color: var(--tinta); text-decoration: none; font: var(--text-corpo); cursor: pointer; list-style: none; }
  .topo__link::-webkit-details-marker { display: none; }
  summary.topo__link::after { content: ''; width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); }
  .topo__link:hover, .menu[open] > .topo__link { background: var(--superficie-sutil); color: var(--tinta); }
  .topo__link.is-ativo { color: var(--acao); }
  .menu { position: relative; }
  .menu__lista { position: absolute; top: calc(100% + 6px); left: 0; min-width: 260px; list-style: none; margin: 0; padding: var(--space-2); background: var(--superficie); border: 1px solid var(--borda); border-radius: var(--radius-lg); box-shadow: var(--sombra-flutuante); }
  .menu__lista a { display: flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: var(--radius-sm); color: var(--tinta); text-decoration: none; }
  .menu__lista a:hover { background: var(--superficie-sutil); }
  .menu__lista li:first-child a { color: var(--tinta-secundaria); font: var(--text-apoio); }
  .topo__acoes { display: none; align-items: center; gap: var(--space-4); margin-left: auto; }
  .topo__login { color: var(--tinta); text-decoration: none; font: var(--text-apoio); white-space: nowrap; }
  .topo__login:hover { color: var(--acao); }

  .movel { margin-left: auto; }
  .movel__botao { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 12px; border: 1px solid var(--borda); border-radius: var(--radius-md); color: var(--tinta); cursor: pointer; list-style: none; }
  .movel__botao::-webkit-details-marker { display: none; }
  .movel__painel { position: absolute; left: 0; right: 0; top: 100%; max-height: calc(100dvh - 72px); overflow-y: auto; background: var(--superficie); border-bottom: 1px solid var(--borda); padding: var(--space-4); display: grid; gap: var(--space-3); box-shadow: var(--sombra-flutuante); }
  .movel__grupo { padding-block: var(--space-2); border-bottom: 1px solid var(--borda-sutil); }
  .movel__titulo { display: flex; align-items: center; min-height: 44px; font: var(--text-titulo-secao); color: var(--tinta); text-decoration: none; }
  .movel__grupo ul { list-style: none; margin: 0; padding: 0 0 0 var(--space-3); }
  .movel__grupo li a { display: flex; align-items: center; min-height: 44px; color: var(--tinta-secundaria); text-decoration: none; }

  @media (min-width: 1100px) {
    .topo__nav, .topo__acoes { display: flex; }
    .movel { display: none; }
  }
</style>
