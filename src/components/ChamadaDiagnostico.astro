---
// Bloco final de conversão, usado no fim da home e das páginas de setor e solução.
import { SITE } from '../data/site';
interface Props { titulo?: string; texto?: string }
const {
  titulo = 'Descubra onde a sua operação está perdendo',
  texto = 'No diagnóstico, nosso time técnico levanta os ativos sensíveis da sua operação, as normas que se aplicam e onde estão os riscos de perda. Sem custo e sem compromisso.',
} = Astro.props;
---
<section class="chamada">
  <div class="container chamada__grade">
    <div class="chamada__texto">
      <p class="rotulo">Diagnóstico gratuito</p>
      <h2 class="display-l">{titulo}</h2>
      <p class="lead">{texto}</p>
    </div>
    <div class="chamada__acoes">
      <a class="botao botao--primario" href="/diagnostico">Solicitar diagnóstico</a>
      <a class="botao botao--secundario" href={SITE.whatsapp}>Falar pelo WhatsApp</a>
    </div>
  </div>
</section>
<style>
  .chamada { padding-block: var(--space-7); }
  .chamada__grade { display: grid; gap: var(--space-5); align-items: end; background: var(--superficie); border: 1px solid var(--borda); border-radius: var(--radius-lg); padding-block: var(--space-6); }
  .chamada__texto { display: grid; gap: var(--space-3); }
  .chamada__acoes { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  @media (min-width: 900px) { .chamada__grade { grid-template-columns: 1.6fr 1fr; padding: var(--space-7); } .chamada__acoes { justify-content: flex-end; } }
</style>
