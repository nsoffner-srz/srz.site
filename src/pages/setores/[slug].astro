---
// Modelo único das páginas de setor (7 blocos). O conteúdo vem de src/content/setores/<slug>.md.
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Trilha from '../../components/Trilha.astro';
import Perguntas from '../../components/Perguntas.astro';
import ChamadaDiagnostico from '../../components/ChamadaDiagnostico.astro';
import CardConteudo from '../../components/CardConteudo.astro';
import { faqJsonLd, trilhaJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const setores = await getCollection('setores');
  return setores.map((s) => ({ params: { slug: s.id }, props: { setor: s } }));
}

const { setor } = Astro.props as { setor: CollectionEntry<'setores'> };
const d = setor.data;
const trilha = [
  { nome: 'Início', caminho: '/' },
  { nome: 'Setores', caminho: '/setores' },
  { nome: d.nome, caminho: `/setores/${setor.id}` },
];
const artigos = (await getCollection('conteudo', (a) => !a.data.rascunho && a.data.setores.includes(setor.id as never)))
  .sort((a, b) => b.data.publicado.getTime() - a.data.publicado.getTime())
  .slice(0, 3);
---
<Base titulo={`${d.nome}: monitoramento em tempo real`} descricao={d.resumo} jsonLd={[trilhaJsonLd(trilha), ...faqJsonLd(d.perguntas)]}>
  <section class="hero-setor">
    <div class="container hero-setor__grade">
      <Trilha itens={trilha} />
      <p class="rotulo">{d.nome}</p>
      <h1 class="display-xl">{d.tituloHero}</h1>
      <p class="lead">{d.subtituloHero}</p>
      <p class="apoio"><strong>Para quem:</strong> {d.publico}</p>
      <div class="hero-setor__acoes">
        <a class="botao botao--primario" href={`/diagnostico?setor=${setor.id}`}>Solicitar diagnóstico</a>
        <a class="botao botao--secundario" href="#como-resolve">Ver como funciona</a>
      </div>
    </div>
  </section>

  <!-- 1. Dor e custo -->
  <section class="secao secao--branca">
    <div class="container dor">
      <div>
        <p class="rotulo">O problema</p>
        <h2 class="display-l">{d.dor.titulo}</h2>
      </div>
      <div class="dor__texto">
        <p class="lead">{d.dor.texto}</p>
        <p class="dor__custo">{d.dor.custo}</p>
      </div>
    </div>
  </section>

  <!-- 2. Norma -->
  {d.normas.length > 0 && (
    <section class="secao">
      <div class="container">
        <div class="secao__topo">
          <p class="rotulo">O que a norma exige</p>
          <h2 class="display-l">Conformidade que se prova com registro</h2>
        </div>
        <div class="grade grade--2">
          {d.normas.map((n) => (
            <div class="card"><h3 class="titulo-secao">{n.nome}</h3><p class="apoio">{n.exige}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 3. Ver, Agir, Provar -->
  <section class="secao secao--branca" id="como-resolve">
    <div class="container">
      <div class="secao__topo">
        <p class="rotulo">Como a Sensoriz resolve</p>
        <h2 class="display-l">Ver, agir e provar</h2>
      </div>
      <ol class="grade grade--3 pilares">
        <li class="card"><span class="pilares__n dado">01</span><h3 class="titulo-secao">Ver</h3><p class="apoio">{d.comoResolve.ver}</p></li>
        <li class="card"><span class="pilares__n dado">02</span><h3 class="titulo-secao">Agir</h3><p class="apoio">{d.comoResolve.agir}</p></li>
        <li class="card"><span class="pilares__n dado">03</span><h3 class="titulo-secao">Provar</h3><p class="apoio">{d.comoResolve.provar}</p></li>
      </ol>
    </div>
  </section>

  <!-- 4. Configuração típica -->
  <section class="secao">
    <div class="container config">
      <div class="secao__topo">
        <p class="rotulo">Configuração típica</p>
        <h2 class="display-l">O que é instalado</h2>
        <p class="apoio">Ambientes atendidos: {d.ambientes.join(' · ')}.</p>
      </div>
      <dl class="config__lista">
        {d.configuracao.map((c) => (<div><dt class="corpo-forte">{c.item}</dt><dd class="apoio">{c.detalhe}</dd></div>))}
      </dl>
      <p class="pendente">Foto dos dispositivos instalados neste setor: pendente</p>
    </div>
  </section>

  <!-- 5. Case ou depoimento -->
  <section class="secao secao--branca">
    <div class="container">
      <div class="secao__topo">
        <p class="rotulo">Resultado em operação</p>
        <h2 class="display-l">Case do setor</h2>
      </div>
      <div class="card case-vazio">
        <p class="pendente">Case e depoimento: aguardando aprovação do cliente</p>
        <p class="apoio">Formato: cenário inicial, impacto em R$, solução e resultado. O cliente aparece pelo segmento até autorizar o nome.</p>
      </div>
    </div>
  </section>

  <!-- 6. Perguntas frequentes -->
  <section class="secao">
    <div class="container"><Perguntas itens={d.perguntas} /></div>
  </section>

  {artigos.length > 0 && (
    <section class="secao secao--branca">
      <div class="container">
        <div class="secao__topo"><p class="rotulo">Conteúdo</p><h2 class="display-l">Para aprofundar</h2></div>
        <div class="grade grade--3">
          {artigos.map((a) => <CardConteudo href={`/conteudo/${a.id}`} titulo={a.data.titulo} descricao={a.data.descricao} tema={a.data.tema} data={a.data.publicado} />)}
        </div>
      </div>
    </section>
  )}

  <!-- 7. CTA -->
  <ChamadaDiagnostico />
</Base>

<style>
  .hero-setor { padding-block: var(--space-6) var(--space-7); }
  .hero-setor__grade { display: grid; gap: var(--space-4); }
  .hero-setor__grade > * { max-width: 900px; }
  .hero-setor__acoes { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
  .dor { display: grid; gap: var(--space-5); }
  .dor__texto { display: grid; gap: var(--space-4); align-content: start; }
  .dor__custo { font: var(--text-corpo-forte); padding: var(--space-4); background: var(--superficie-sutil); border-radius: var(--radius-md); }
  @media (min-width: 900px) { .dor { grid-template-columns: 1fr 1fr; gap: var(--space-7); } }
  .pilares { list-style: none; padding: 0; margin: 0; }
  .pilares li { display: grid; gap: var(--space-2); align-content: start; }
  .pilares__n { color: var(--acao); font-size: 15px; }
  .config__lista { display: grid; gap: var(--space-4); margin: 0 0 var(--space-5); }
  .config__lista > div { display: grid; gap: 4px; padding-bottom: var(--space-4); border-bottom: 1px solid var(--borda); }
  .config__lista dd { margin: 0; }
  @media (min-width: 768px) { .config__lista { grid-template-columns: 1fr 1fr; column-gap: var(--space-6); } }
  .case-vazio { display: grid; gap: var(--space-3); }
  .corpo-forte { font: var(--text-corpo-forte); }
</style>
