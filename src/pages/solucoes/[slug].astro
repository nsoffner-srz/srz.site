---
import Base from '../../layouts/Base.astro';
import Trilha from '../../components/Trilha.astro';
import Perguntas from '../../components/Perguntas.astro';
import ChamadaDiagnostico from '../../components/ChamadaDiagnostico.astro';
import { SOLUCOES_DETALHE, type Solucao } from '../../data/solucoes';
import { SETORES_ROTULO } from '../../data/site';
import { faqJsonLd, trilhaJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return SOLUCOES_DETALHE.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Solucao };
const trilha = [{ nome: 'Início', caminho: '/' }, { nome: 'Soluções', caminho: '/solucoes' }, { nome: s.nome, caminho: `/solucoes/${s.slug}` }];
---
<Base titulo={s.nome} descricao={s.resumo} jsonLd={[trilhaJsonLd(trilha), ...faqJsonLd(s.perguntas)]}>
  <section class="secao">
    <div class="container topo-solucao">
      <Trilha itens={trilha} />
      <p class="rotulo">{s.nome}</p>
      <h1 class="display-xl">{s.titulo}</h1>
      <p class="lead">{s.resumo}</p>
      <div><a class="botao botao--primario" href="/diagnostico">Solicitar diagnóstico</a></div>
    </div>
  </section>
  <section class="secao secao--branca">
    <div class="container">
      <div class="grade grade--2">
        {s.blocos.map((b) => <div class="card bloco"><h2 class="titulo-secao">{b.titulo}</h2><p class="apoio">{b.texto}</p></div>)}
      </div>
    </div>
  </section>
  <section class="secao">
    <div class="container">
      <div class="secao__topo"><p class="rotulo">Onde se aplica</p><h2 class="display-l">Setores</h2></div>
      <ul class="setores-links">
        {s.setores.map((id) => <li><a class="botao botao--secundario" href={`/setores/${id}`}>{SETORES_ROTULO[id]}</a></li>)}
      </ul>
    </div>
  </section>
  <section class="secao secao--branca"><div class="container"><Perguntas itens={s.perguntas} /></div></section>
  <ChamadaDiagnostico />
</Base>
<style>
  .topo-solucao { display: grid; gap: var(--space-4); }
  .topo-solucao > * { max-width: 900px; }
  .bloco { display: grid; gap: var(--space-2); align-content: start; }
  .setores-links { display: flex; flex-wrap: wrap; gap: var(--space-3); list-style: none; padding: 0; margin: 0; }
</style>
