---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Trilha from '../../../components/Trilha.astro';
import CardConteudo from '../../../components/CardConteudo.astro';
import FiltrosConteudo from '../../../components/FiltrosConteudo.astro';
import { SETORES } from '../../../content.config';
import { SETORES_ROTULO } from '../../../data/site';
import { trilhaJsonLd } from '../../../lib/seo';

export function getStaticPaths() {
  return SETORES.map((setor) => ({ params: { setor } }));
}
const { setor } = Astro.params as { setor: string };
const nome = SETORES_ROTULO[setor];
const artigos = (await getCollection('conteudo', (a) => !a.data.rascunho && a.data.setores.includes(setor as never)))
  .sort((a, b) => b.data.publicado.getTime() - a.data.publicado.getTime());
const trilha = [{ nome: 'Início', caminho: '/' }, { nome: 'Conteúdo', caminho: '/conteudo' }, { nome, caminho: `/conteudo/setor/${setor}` }];
---
<Base titulo={`${nome} | Conteúdo`} descricao={`Artigos da Sensoriz para ${nome.toLowerCase()}: normas, perdas e gestão da operação.`} jsonLd={[trilhaJsonLd(trilha)]} semIndice={artigos.length === 0}>
  <section class="secao">
    <div class="container">
      <div class="secao__topo">
        <Trilha itens={trilha} />
        <h1 class="display-l">Conteúdo para {nome}</h1>
        <p class="apoio"><a href={`/setores/${setor}`}>Ver como a Sensoriz atende {nome}</a></p>
      </div>
      <FiltrosConteudo />
      {artigos.length ? (
        <div class="grade grade--3">
          {artigos.map((a) => <CardConteudo href={`/conteudo/${a.id}`} titulo={a.data.titulo} descricao={a.data.descricao} tema={a.data.tema} data={a.data.publicado} />)}
        </div>
      ) : <p class="apoio">Ainda não há artigos para este setor.</p>}
    </div>
  </section>
</Base>
