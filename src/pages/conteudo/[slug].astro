---
// Página de artigo. Gera Article + FAQPage + Breadcrumb em dados estruturados.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Trilha from '../../components/Trilha.astro';
import Perguntas from '../../components/Perguntas.astro';
import ChamadaDiagnostico from '../../components/ChamadaDiagnostico.astro';
import { TEMAS_ROTULO, SETORES_ROTULO, SITE } from '../../data/site';
import { faqJsonLd, trilhaJsonLd, formatarData } from '../../lib/seo';

export async function getStaticPaths() {
  const artigos = await getCollection('conteudo', (a) => !a.data.rascunho);
  return artigos.map((a) => ({ params: { slug: a.id }, props: { artigo: a } }));
}
const { artigo } = Astro.props as { artigo: CollectionEntry<'conteudo'> };
const { Content } = await render(artigo);
const d = artigo.data;
const url = `${SITE.url}/conteudo/${artigo.id}`;
const trilha = [
  { nome: 'Início', caminho: '/' },
  { nome: 'Conteúdo', caminho: '/conteudo' },
  { nome: TEMAS_ROTULO[d.tema], caminho: `/conteudo/tema/${d.tema}` },
  { nome: d.titulo, caminho: `/conteudo/${artigo.id}` },
];
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titulo,
  description: d.descricao,
  datePublished: d.publicado.toISOString(),
  dateModified: (d.atualizado ?? d.publicado).toISOString(),
  inLanguage: 'pt-BR',
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: d.autor, url: SITE.url },
  publisher: { '@id': `${SITE.url}/#organizacao` },
  about: d.setores.map((s) => SETORES_ROTULO[s]),
};
---
<Base titulo={d.titulo} descricao={d.descricao} tipoOg="article" jsonLd={[articleLd, trilhaJsonLd(trilha), ...faqJsonLd(d.perguntas)]}>
  <article class="secao">
    <div class="container artigo">
      <header class="artigo__topo">
        <Trilha itens={trilha} />
        <p class="rotulo"><a href={`/conteudo/tema/${d.tema}`}>{TEMAS_ROTULO[d.tema]}</a></p>
        <h1 class="display-l">{d.titulo}</h1>
        <p class="lead">{d.descricao}</p>
        <p class="apoio">
          {d.autor} · <time datetime={d.publicado.toISOString()}>{formatarData(d.publicado)}</time>
          {d.atualizado && <> · atualizado em <time datetime={d.atualizado.toISOString()}>{formatarData(d.atualizado)}</time></>}
        </p>
        {d.setores.length > 0 && (
          <ul class="artigo__setores">
            {d.setores.map((s) => <li><a class="chip chip--info" href={`/conteudo/setor/${s}`}>{SETORES_ROTULO[s]}</a></li>)}
          </ul>
        )}
      </header>
      <div class="prosa"><Content /></div>
      {d.perguntas.length > 0 && <div class="artigo__perguntas"><Perguntas itens={d.perguntas} titulo="Resumo em perguntas" /></div>}
    </div>
  </article>
  <ChamadaDiagnostico />
</Base>
<style>
  .artigo { display: grid; gap: var(--space-6); }
  .artigo > * { max-width: 820px; }
  .artigo__topo { display: grid; gap: var(--space-3); }
  .artigo__topo .rotulo a { color: var(--acao); text-decoration: none; }
  .artigo__setores { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; margin: 0; }
  .artigo__setores a { text-decoration: none; min-height: 32px; }
  .artigo__perguntas { max-width: 70ch; }
</style>
